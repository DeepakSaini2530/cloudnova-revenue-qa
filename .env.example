# Copy to .env to override. Every value below is the default; no secrets are needed.
# The question layer calls the local Claude Code CLI (`claude`), which uses its own login.

RAW_CSV=data/cloudnova_invoices.csv
DB_PATH=build/cloudnova.duckdb

# divide: amount_usd = amount / rate (reconciles to list price; see specs/01-clean-schema.md)
# multiply: amount_usd = amount * rate (literal reading of the briefing)
FX_MODE=divide
FX_EUR=1.08
FX_GBP=1.27

# Model alias or full name passed to `claude --model`
CLAUDE_MODEL=sonnet
# Seconds to wait for one model call
CLAUDE_TIMEOUT=120
